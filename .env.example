# --- Database (Turso / libsql) ---
# Create a free database at https://turso.tech, then:
#   turso db show <db-name> --url
#   turso db tokens create <db-name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Admin panel (/admin) ---
# Password gate for the admin panel. Keep it secret.
ADMIN_PASSWORD=

# --- Site URL (SEO) ---
# Public URL of the deployed site, e.g. https://aitoolshub.pk
# Used for sitemap.xml, robots.txt and Open Graph tags.
NEXT_PUBLIC_SITE_URL=
